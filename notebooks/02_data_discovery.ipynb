if not (PROJECT_ROOT / "config/project.yml").exists():
    base_directory = Path("/content") if Path("/content").exists() else Path.cwd()
    PROJECT_ROOT = base_directory / "parcel-a-agri-geospatial"
    PROJECT_ROOT.mkdir(parents=True, exist_ok=True)
    bundled_files = json.loads(
        zlib.decompress(base64.b64decode(PROJECT_BUNDLE_B64)).decode("utf-8")
    )
    for relative_path, encoded_content in bundled_files.items():
        target = PROJECT_ROOT / relative_path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(base64.b64decode(encoded_content))

subprocess.check_call(
    [sys.executable, "-m", "pip", "install", "-q", "-r", str(PROJECT_ROOT / "requirements.txt")]
)
sys.path.insert(0, str(PROJECT_ROOT / "src"))
for module_name in list(sys.modules):
    if module_name == "parcel_a_geo" or module_name.startswith("parcel_a_geo."):
        del sys.modules[module_name]

import ee
import folium
from IPython.display import HTML, clear_output, display
from parcel_a_geo.config import load_dataset_registry, load_project_config, project_path
from parcel_a_geo.discovery import DiscoveryRunner
from parcel_a_geo.validation import load_aoi

EARTH_ENGINE_PROJECT = os.getenv("EARTH_ENGINE_PROJECT", "practical-proxy-441422-n6")
os.environ["EARTH_ENGINE_PROJECT"] = EARTH_ENGINE_PROJECT
try:
    ee.Initialize(project=EARTH_ENGINE_PROJECT)
except Exception:
    ee.Authenticate(auth_mode="notebook", force=True)
    ee.Initialize(project=EARTH_ENGINE_PROJECT)

if ee.String("Parcel A Stage 02").getInfo() != "Parcel A Stage 02":
    raise RuntimeError("Earth Engine server connection could not be verified")

project_config = load_project_config(PROJECT_ROOT / "config/project.yml")
aoi = load_aoi(
    project_path(PROJECT_ROOT, project_config["aoi_path"]),
    project_config["aoi_identifier"],
)
registry = load_dataset_registry(PROJECT_ROOT / "config/datasets.yml")

runner = DiscoveryRunner(PROJECT_ROOT, progress=lambda _: None)
runner.config["earth_engine_enabled"] = True
runner.run_all()
inventory_table = runner.inventory.frame()
output_paths = runner.write_outputs()
archive_path = Path(
    shutil.make_archive(
        str(PROJECT_ROOT / "outputs/stage02_results"),
        "zip",
        root_dir=runner.output_dir,
    )
)

clear_output(wait=True)

# Display the approved Parcel A AOI.
aoi_map = folium.Map(location=[aoi.centroid[1], aoi.centroid[0]], zoom_start=11, tiles="CartoDB positron")
folium.GeoJson(
    aoi.wgs84.__geo_interface__,
    name="Parcel A",
    style_function=lambda _: {"color": "#176b3a", "weight": 4, "fillColor": "#52b788", "fillOpacity": 0.12},
).add_to(aoi_map)
folium.Marker(location=[aoi.centroid[1], aoi.centroid[0]], tooltip="Parcel A centroid").add_to(aoi_map)
minx, miny, maxx, maxy = aoi.bounds
aoi_map.fit_bounds([[miny, minx], [maxy, maxx]])
folium.LayerControl(collapsed=False).add_to(aoi_map)
display(aoi_map)

# Strict verification: confirmed coverage + valid in-AOI data + working automated access.
coverage_confirmed = inventory_table["AOI_coverage_status"].isin(["FULL_COVERAGE", "PARTIAL_COVERAGE"])
valid_inside_aoi = inventory_table["valid_data_status"].isin(["VALID_DATA", "VALID_RECORDS"])
access_succeeded = inventory_table["access_status"].eq("AUTOMATED_OPEN")
verified_inside_aoi = coverage_confirmed & valid_inside_aoi & access_succeeded

no_coverage = inventory_table["AOI_coverage_status"].eq("NO_COVERAGE")
access_failed = inventory_table["access_status"].eq("VERIFICATION_FAILED")
metadata_only = (
    ~verified_inside_aoi
    & ~no_coverage
    & ~access_failed
    & inventory_table["access_status"].isin(["MANUAL_DOWNLOAD_AVAILABLE", "MANUAL_INSPECTION_REQUIRED"])
)
manual_review = (
    ~verified_inside_aoi
    & ~no_coverage
    & ~access_failed
    & (
        inventory_table["processing_priority"].eq("NEEDS_MANUAL_REVIEW")
        | inventory_table["access_status"].isin(["AUTOMATED_AUTHENTICATION_REQUIRED", "ACCESS_RESTRICTED"])
    )
)
pending_other = ~(verified_inside_aoi | no_coverage | access_failed | metadata_only | manual_review)

ready_next = verified_inside_aoi & inventory_table["processing_priority"].eq("USE_NEXT")
ready_later = verified_inside_aoi & inventory_table["processing_priority"].eq("USE_LATER")
verified_optional = verified_inside_aoi & ~(ready_next | ready_later)

inventory_table = inventory_table.copy()
inventory_table["Stage_02_status"] = "PENDING_REVIEW"
inventory_table.loc[metadata_only, "Stage_02_status"] = "METADATA_ONLY"
inventory_table.loc[manual_review | pending_other, "Stage_02_status"] = "MANUAL_VERIFICATION_REQUIRED"
inventory_table.loc[no_coverage, "Stage_02_status"] = "NO_COVERAGE"
inventory_table.loc[access_failed, "Stage_02_status"] = "ACCESS_FAILED"
inventory_table.loc[verified_inside_aoi, "Stage_02_status"] = "VERIFIED_INSIDE_AOI"

def build_evidence(row):
    parts = [
        f"Method: {row.get('validation_method', 'UNKNOWN')}",
        f"Coverage: {row.get('AOI_coverage_status', 'UNKNOWN')}",
        f"Data test: {row.get('valid_data_status', 'UNKNOWN')}",
        f"Access: {row.get('access_status', 'UNKNOWN')}",
    ]
    notes = str(row.get("notes", "UNKNOWN"))
    if notes not in {"", "UNKNOWN", "None"}:
        parts.append(f"Evidence: {notes}")
    failure = str(row.get("failure_reason", "UNKNOWN"))
    if failure not in {"", "UNKNOWN", "None"}:
        parts.append(f"Failure: {failure}")
    return " | ".join(parts)

inventory_table["Verification evidence"] = inventory_table.apply(build_evidence, axis=1)

cards = [
    ("Sources reviewed", len(inventory_table)),
    ("Verified inside Parcel A", int(verified_inside_aoi.sum())),
    ("Ready for Stage 03", int(ready_next.sum())),
    ("Verified for later use", int(ready_later.sum())),
    ("Need further verification", int((~verified_inside_aoi & ~no_coverage).sum())),
]
card_html = "".join(
    f'<div style="background:#fff;border:1px solid #dfe7e2;border-radius:10px;padding:14px 16px;min-width:150px;">'
    f'<div style="font-size:26px;font-weight:700;color:#176b3a;">{value}</div>'
    f'<div style="font-size:13px;color:#455a4f;">{label}</div></div>'
    for label, value in cards
)
display(HTML(
    '<div style="font-family:Arial,sans-serif;">'
    '<p><strong>Google Earth Engine connected.</strong> All registered sources were reviewed. '
    'Availability inside Parcel A was verified only where AOI coverage, valid in-AOI data, '
    'and working programmatic access were confirmed.</p>'
    '<h3>Stage 02 result</h3>'
    f'<div style="display:flex;gap:10px;flex-wrap:wrap;">{card_html}</div></div>'
))

DISPLAY_COLUMNS = ["dataset_name", "source_name", "agricultural_theme", "spatial_resolution", "Stage_02_status", "Verification evidence"]
DISPLAY_NAMES = {
    "dataset_name": "Dataset",
    "source_name": "Source",
    "agricultural_theme": "Agricultural use",
    "spatial_resolution": "Resolution",
    "Stage_02_status": "Status",
}

def show_group(title, mask, empty_message):
    display(HTML(f"<h3>{title}</h3>"))
    table = inventory_table.loc[mask, DISPLAY_COLUMNS].copy()
    if table.empty:
        display(HTML(f"<p>{empty_message}</p>"))
    else:
        display(HTML(table.rename(columns=DISPLAY_NAMES).to_html(index=False, escape=True, border=0)))

show_group("1. Verified and ready for Stage 03", ready_next, "No dataset currently meets all strict requirements for immediate Stage 03 use.")
show_group("2. Verified inside Parcel A but useful later", ready_later | verified_optional, "No dataset is currently classified in this group.")
show_group("3. Metadata found but not verified inside Parcel A", metadata_only | manual_review | pending_other, "No dataset is currently classified in this group.")
show_group("4. No coverage or access failed", no_coverage | access_failed, "No dataset is currently classified in this group.")

# Keep the six priority FAO sources explicit in the result.
fao_focus_names = ["GAEZ v5", "WaPOR v3", "SoilFER", "SoilFER CropSuit App", "CAVA", "ASIS"]
show_group(
    "FAO priority-source verification",
    inventory_table["source_name"].isin(fao_focus_names),
    "No FAO priority source is registered. Check config/datasets.yml.",
)

# Save the strict inventory without replacing the original technical outputs.
corrected_csv = runner.output_dir / "tables" / "data_inventory_strict.csv"
corrected_xlsx = runner.output_dir / "tables" / "data_inventory_strict.xlsx"
corrected_json = runner.output_dir / "metadata" / "data_inventory_strict.json"
corrected_csv.parent.mkdir(parents=True, exist_ok=True)
corrected_json.parent.mkdir(parents=True, exist_ok=True)
inventory_table.to_csv(corrected_csv, index=False)
inventory_table.to_excel(corrected_xlsx, index=False)
corrected_json.write_text(inventory_table.to_json(orient="records", indent=2), encoding="utf-8")

archive_path = Path(shutil.make_archive(
    str(PROJECT_ROOT / "outputs/stage02_results_fixed"),
    "zip",
    root_dir=runner.output_dir,
))

display(HTML(
    '<h3>Results package ready</h3>'
    '<p>The ZIP contains the report, coverage map, original inventory, strict inventory, and technical log. '
    'Stage 03 has not been started.</p>'
))
try:
    from google.colab import files
    files.download(str(archive_path))
except ImportError:
    from IPython.display import FileLink
    display(FileLink(str(archive_path)))

print("SUCCESS: Stage 02 strict data discovery completed")
